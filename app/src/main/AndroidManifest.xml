<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Complete installed-package inventory: required to find non-launchable apps that
         declare sensitive permissions. Skopos is sideloaded as a privacy/security Vector
         module, not distributed via Play. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Launchable-app visibility for scope discovery (no QUERY_ALL_PACKAGES). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="Skopos"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- The Vector daemon delivers its service binder to this authority
             ({applicationId} + ".XposedService") by forging a ContentProvider call;
             exported because the daemon reaches it across processes. -->
        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="org.a4real.skopos.XposedService"
            android:exported="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>